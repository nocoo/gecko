{
  "name": "gecko",
  "version": "1.11.1",
  "private": true,
  "scripts": {
    "dev": "bun run --cwd apps/web-dashboard dev",
    "prepare": "husky",
    "release": "bun run scripts/release.ts",
    "typecheck": "bun run --cwd apps/web-dashboard typecheck",
    "lint": "bun run --cwd apps/web-dashboard lint",
    "test:l1": "bun run --cwd apps/web-dashboard test:coverage",
    "test:l2": "bun run --cwd apps/web-dashboard test:e2e",
    "test:l3": "bun run --cwd apps/web-dashboard test:bdd",
    "test:e2e:bdd": "bun run test:l3"
  },
  "devDependencies": {
    "@nocoo/basalt": "2.0.3",
    "husky": "^9.1.7"
  }
}
