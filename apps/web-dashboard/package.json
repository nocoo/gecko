{
  "name": "gecko-web",
  "version": "1.9.0",
  "description": "Gecko screen time dashboard",
  "type": "module",
  "scripts": {
    "dev": "vinext dev --port 7018",
    "build": "vinext build",
    "start": "vinext start --port 7018",
    "db:init": "bun run scripts/init-local-db.ts",
    "dev:e2e": "bun run db:init && E2E_SKIP_AUTH=true D1_LOCAL_PATH=.local/gecko-test.db vinext dev --port 17018",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0",
    "lint:staged": "lint-staged",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bun run db:init && RUN_E2E=true D1_LOCAL_PATH=.local/gecko-test.db bun test src/__tests__/e2e/ --timeout 60000",
    "dev:bdd": "bun run db:init && E2E_SKIP_AUTH=true D1_LOCAL_PATH=.local/gecko-test.db vinext dev --port 27018",
    "test:bdd": "bunx playwright test",
    "gate:security": "bun run scripts/gate-security.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.5",
    "better-sqlite3": "^12.9.0",
    "eslint": "9",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.2",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/openai": "^3.0.68",
    "@hono/node-server": "^1.19.13",
    "@nocoo/next-ai": "^0.2.1",
    "ai": "^6.0.198",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express-rate-limit": "^8.3.2",
    "hono": "^4.12.17",
    "lucide-react": "^0.575.0",
    "next": "16.2.7",
    "next-auth": "^5.0.0-beta.30",
    "radix-ui": "^1.4.3",
    "react": "^19.2.7",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vinext": "^0.0.9"
  },
  "overrides": {
    "hono": "^4.12.14",
    "@hono/node-server": "^1.19.13",
    "express-rate-limit": "^8.2.2",
    "ip-address": "^10.1.1",
    "postcss": "^8.5.10",
    "flatted": "^3.4.0",
    "serialize-javascript": "^7.0.5",
    "brace-expansion": "^2.0.2",
    "path-to-regexp": "^8.4.0",
    "picomatch": "^4.0.4",
    "srvx": "^0.11.13"
  }
}
