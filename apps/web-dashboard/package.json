{
  "name": "gecko-web",
  "version": "1.12.1",
  "description": "Gecko screen time dashboard",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vinext dev --port 7018",
    "build": "vinext build",
    "start": "vinext start --port 7018",
    "db:init": "bun run scripts/init-local-db.ts",
    "dev:e2e": "bun run db:init && E2E_SKIP_AUTH=true AUTH_SECRET=e2e-test-secret D1_LOCAL_PATH=.local/gecko-test.db vinext dev --port 17018",
    "typecheck": "vinext typegen && tsc --noEmit",
    "lint": "biome check --error-on-warnings --max-diagnostics=500 .",
    "lint:fix": "biome check --write --error-on-warnings --max-diagnostics=500 .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:l1": "vitest run --coverage",
    "test:l2": "bun run test:e2e",
    "test:l3": "bun run test:bdd",
    "test:e2e": "bun run db:init && RUN_E2E=true D1_LOCAL_PATH=.local/gecko-test.db bun test src/__tests__/e2e/ --timeout 60000",
    "dev:bdd": "bun run db:init && E2E_SKIP_AUTH=true AUTH_SECRET=e2e-test-secret D1_LOCAL_PATH=.local/gecko-test.db vinext dev --port 27018",
    "test:bdd": "bunx playwright test",
    "gate:security": "bun run scripts/gate-security.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "@vitest/coverage-v8": "5.0.2",
    "better-sqlite3": "13.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "@nocoo/basalt": "2.1.8",
    "@nocoo/next-ai": "^0.4.0",
    "ai": "7.0.111",
    "clsx": "^2.1.1",
    "lucide-react": "1.47.0",
    "next": "16.3.6",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "^19.3.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "^1.4.0",
    "vinext": "1.0.0-beta.0"
  },
  "overrides": {
    "@ai-sdk/provider-utils": "5.0.45",
    "image-size": "2.0.4",
    "baseline-browser-mapping": "2.11.26",
    "browserslist": "4.29.3",
    "postcss": "^8.5.28",
    "picomatch": "^4.0.4",
    "srvx": "^0.12.8",
    "nanoid": "3.3.19",
    "vite": "^8.3.1",
    "sharp": "0.35.4",
    "fast-uri": "3.1.8",
    "fflate": "0.7.5",
    "undici": "7.30.0"
  }
}
