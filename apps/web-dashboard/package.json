{
  "name": "gecko-web",
  "version": "1.10.12",
  "description": "Gecko screen time dashboard",
  "type": "module",
  "scripts": {
    "dev": "vinext dev --port 7018",
    "build": "vinext build",
    "start": "vinext start --port 7018",
    "db:init": "bun run scripts/init-local-db.ts",
    "dev:e2e": "bun run db:init && E2E_SKIP_AUTH=true AUTH_SECRET=e2e-test-secret D1_LOCAL_PATH=.local/gecko-test.db vinext dev --port 17018",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0",
    "lint:staged": "lint-staged",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bun run db:init && RUN_E2E=true D1_LOCAL_PATH=.local/gecko-test.db bun test src/__tests__/e2e/ --timeout 60000",
    "dev:bdd": "bun run db:init && E2E_SKIP_AUTH=true AUTH_SECRET=e2e-test-secret D1_LOCAL_PATH=.local/gecko-test.db vinext dev --port 27018",
    "test:bdd": "bunx playwright test",
    "gate:security": "bun run scripts/gate-security.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitejs/plugin-rsc": "^0.5.27",
    "@vitest/coverage-v8": "4.1.10",
    "better-sqlite3": "^12.11.1",
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "^8.1.3",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.10",
    "@ai-sdk/openai": "4.0.8",
    "@hono/node-server": "^2.0.8",
    "@nocoo/next-ai": "^0.4.0",
    "ai": "7.0.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express-rate-limit": "^8.5.2",
    "hono": "4.12.28",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.30",
    "radix-ui": "1.6.2",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "^19.2.7",
    "recharts": "3.9.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vinext": "1.0.0-beta.0"
  },
  "overrides": {
    "hono": "^4.12.28",
    "@hono/node-server": "^2.0.8",
    "express-rate-limit": "^8.2.2",
    "ip-address": "^10.1.1",
    "postcss": "^8.5.10",
    "flatted": "^3.4.0",
    "serialize-javascript": "^7.0.5",
    "brace-expansion": "^2.0.2",
    "path-to-regexp": "^8.4.0",
    "picomatch": "^4.0.4",
    "qs": "^6.15.2",
    "srvx": "^0.11.13",
    "esbuild": "^0.28.1",
    "js-yaml": "^4.2.0",
    "@babel/core": "^7.29.6",
    "vite": "^8.1.3"
  }
}
