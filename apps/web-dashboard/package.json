{
  "name": "gecko-web",
  "version": "2.0.4",
  "description": "Gecko screen time dashboard",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vinext dev --port 7018",
    "build": "vinext build",
    "start": "vinext start --port 7018",
    "db:local": "bun run scripts/db-local.ts",
    "typecheck": "cf workers types && vinext typegen && tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "lint": "biome check --error-on-warnings --max-diagnostics=500 .",
    "lint:fix": "biome check --write --error-on-warnings --max-diagnostics=500 .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:l1": "vitest run --coverage",
    "test:l2": "bun run scripts/run-tests.ts l2",
    "test:l3": "bun run scripts/run-tests.ts l3",
    "test:e2e": "bun run test:l2",
    "test:bdd": "bun run test:l3",
    "gate:security": "bun run scripts/gate-security.ts",
    "cutover:baseline": "bun run scripts/cutover-cf.ts baseline",
    "cutover:remap": "bun run scripts/cutover-cf.ts remap",
    "cutover:deploy": "bun run scripts/cutover-cf.ts deploy",
    "cd:publish": "bun run scripts/cd-publish.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-c82c3efb3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "@vitest/coverage-v8": "5.0.3",
    "cf": "1.0.0-beta.13",
    "image-size": "2.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@nocoo/basalt": "3.2.0",
    "@nocoo/next-ai": "^0.4.0",
    "@vinext/cloudflare": "1.1.0",
    "ai": "7.0.126",
    "clsx": "^2.1.1",
    "jose": "6.2.12",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "^19.3.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "^1.4.0",
    "vinext": "1.1.0"
  },
  "overrides": {
    "@ai-sdk/provider-utils": "5.0.53",
    "image-size": "2.0.4",
    "baseline-browser-mapping": "2.11.26",
    "browserslist": "4.29.3",
    "postcss": "^8.5.28",
    "picomatch": "^4.0.4",
    "srvx": "^0.12.8",
    "nanoid": "3.3.19",
    "vite": "^8.3.1",
    "sharp": "0.35.5",
    "fast-uri": "3.1.8",
    "fflate": "0.7.5",
    "undici": "7.30.0",
    "source-map-js": "1.2.2"
  }
}
