{
  "name": "gecko-web",
  "version": "1.10.0",
  "description": "Gecko screen time dashboard",
  "type": "module",
  "scripts": {
    "dev": "vinext dev --port 7018",
    "build": "vinext build",
    "start": "vinext start --port 7018",
    "db:init": "bun run scripts/init-local-db.ts",
    "dev:e2e": "bun run db:init && E2E_SKIP_AUTH=true D1_LOCAL_PATH=.local/gecko-test.db vinext dev --port 17018",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0",
    "lint:staged": "lint-staged",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bun run db:init && RUN_E2E=true D1_LOCAL_PATH=.local/gecko-test.db bun test src/__tests__/e2e/ --timeout 60000",
    "dev:bdd": "bun run db:init && E2E_SKIP_AUTH=true D1_LOCAL_PATH=.local/gecko-test.db vinext dev --port 27018",
    "test:bdd": "bunx playwright test",
    "gate:security": "bun run scripts/gate-security.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitejs/plugin-rsc": "^0.5.27",
    "@vitest/coverage-v8": "^4.1.8",
    "better-sqlite3": "^12.10.1",
    "eslint": "^10.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.84",
    "@ai-sdk/openai": "^3.0.71",
    "@hono/node-server": "^2.0.4",
    "@nocoo/next-ai": "^0.2.1",
    "ai": "^6.0.204",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express-rate-limit": "^8.5.2",
    "hono": "^4.12.25",
    "lucide-react": "^1.18.0",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.30",
    "radix-ui": "^1.5.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "^19.2.7",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vinext": "^0.1.2"
  },
  "overrides": {
    "hono": "^4.12.14",
    "@hono/node-server": "^2.0.4",
    "express-rate-limit": "^8.2.2",
    "ip-address": "^10.1.1",
    "postcss": "^8.5.10",
    "flatted": "^3.4.0",
    "serialize-javascript": "^7.0.5",
    "brace-expansion": "^2.0.2",
    "path-to-regexp": "^8.4.0",
    "picomatch": "^4.0.4",
    "qs": "^6.15.2",
    "srvx": "^0.11.13",
    "esbuild": "^0.28.1"
  }
}
