{
  "name": "gecko-web",
  "version": "1.11.0",
  "description": "Gecko screen time dashboard",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vinext dev --port 7018",
    "build": "vinext build",
    "start": "vinext start --port 7018",
    "db:init": "bun run scripts/init-local-db.ts",
    "dev:e2e": "bun run db:init && E2E_SKIP_AUTH=true AUTH_SECRET=e2e-test-secret D1_LOCAL_PATH=.local/gecko-test.db vinext dev --port 17018",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings --max-diagnostics=500 .",
    "lint:fix": "biome check --write --error-on-warnings --max-diagnostics=500 .",
    "lint:staged": "lint-staged",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:l1": "vitest run --coverage",
    "test:l2": "bun run test:e2e",
    "test:l3": "bun run test:bdd",
    "test:e2e": "bun run db:init && RUN_E2E=true D1_LOCAL_PATH=.local/gecko-test.db bun test src/__tests__/e2e/ --timeout 60000",
    "dev:bdd": "bun run db:init && E2E_SKIP_AUTH=true AUTH_SECRET=e2e-test-secret D1_LOCAL_PATH=.local/gecko-test.db vinext dev --port 27018",
    "test:bdd": "bunx playwright test",
    "gate:security": "bun run scripts/gate-security.ts",
    "gate:toolchain": "bun run scripts/gate-toolchain-smoke.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-rsc": "0.5.33",
    "@vitest/coverage-v8": "4.1.10",
    "better-sqlite3": "13.0.3",
    "husky": "^9.1.7",
    "lint-staged": "17.3.0",
    "shadcn": "4.16.2",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.2.1",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.32",
    "@ai-sdk/openai": "4.0.33",
    "@hono/node-server": "2.1.0",
    "@nocoo/next-ai": "^0.4.0",
    "ai": "7.0.55",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express-rate-limit": "^8.6.2",
    "hono": "4.13.0",
    "lucide-react": "1.29.0",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "radix-ui": "1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "^19.2.8",
    "recharts": "3.10.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vinext": "1.0.0-beta.0"
  },
  "overrides": {
    "hono": "4.13.0",
    "@hono/node-server": "^2.1.0",
    "express-rate-limit": "^8.2.2",
    "ip-address": "10.3.1",
    "postcss": "^8.5.18",
    "flatted": "^3.4.0",
    "serialize-javascript": "^7.0.5",
    "body-parser": "^2.3.0",
    "brace-expansion": "5.0.9",
    "path-to-regexp": "^8.4.0",
    "picomatch": "^4.0.4",
    "qs": "^6.15.2",
    "srvx": "^0.12.4",
    "esbuild": "^0.28.1",
    "js-yaml": "^4.3.1",
    "@babel/core": "^7.29.6",
    "vite": "^8.2.1",
    "sharp": "^0.35.0",
    "fast-uri": "3.1.5",
    "undici": "7.29.0"
  }
}
