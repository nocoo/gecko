# Web: G1 (typecheck + lint-staged) → L1 (unit tests + coverage)
# Mac:  G1 (swiftlint --strict) → L1 (xcodebuild test)
# Run in parallel, fail if either fails

(cd apps/web-dashboard && bun run typecheck && bun run lint:staged && bun run test:coverage) &
PID_WEB=$!

(
  if [ -d apps/mac-client ]; then
    if command -v swiftlint >/dev/null 2>&1 && xcrun --find xcodebuild >/dev/null 2>&1; then
      cd apps/mac-client && swiftlint --strict || exit $?
      if security find-identity -v -p codesigning 2>/dev/null | grep -q '0 valid identities found'; then
        echo "⚠️  no codesigning identity available, running mac-client tests unsigned"
        xcodebuild test -project Gecko.xcodeproj -scheme Gecko -destination 'platform=macOS' -only-testing:GeckoTests CODE_SIGNING_ALLOWED=NO CODE_SIGN_IDENTITY="" -quiet
      else
        xcodebuild test -project Gecko.xcodeproj -scheme Gecko -destination 'platform=macOS' -only-testing:GeckoTests -quiet
      fi
    else
      echo "⚠️  swiftlint or xcodebuild not available, skipping mac-client checks"
    fi
  fi
) &
PID_MAC=$!

FAIL=0
wait $PID_WEB || FAIL=1
wait $PID_MAC || FAIL=1

exit $FAIL
